{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/l/1000000000000000001",
        "http://127.0.0.1:3000/l/1000000000000000001/league"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "DATA_DIR=${E2E_DATA_DIR:?seed first (see tests/README.md) or run via pnpm gate} SIDELINE_GALLERY=1 pnpm --filter @sideline/web start:standalone",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 204800 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
