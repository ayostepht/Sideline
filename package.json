{
  "name": "sideline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep UI2",
    "test:contract": "vitest run --project contract",
    "lhci": "lhci autorun",
    "screens": "tsx scripts/screens.ts",
    "validate:scoring": "tsx scripts/validate-scoring/index.ts",
    "backtest": "tsx scripts/not-implemented.ts T3.5 backtest",
    "sync": "tsx scripts/dev-run.ts sync",
    "db:migrate": "pnpm -C packages/db run db:migrate",
    "db:seed:fixtures": "pnpm -C apps/worker run db:seed:fixtures",
    "gate": "tsx scripts/gate.ts",
    "fixtures:record": "tsx scripts/fixtures/record.ts",
    "fixtures:check": "tsx scripts/fixtures/record.ts --check",
    "dev:worker": "tsx scripts/dev-run.ts worker",
    "dev:lan": "tsx scripts/dev-lan.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "msw": "3.0.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
