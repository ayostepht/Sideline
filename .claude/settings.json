{
  "permissions": {
    "allow": [
      "Bash(python3 -)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-resume.sh"
          }
        ]
      }
    ]
  }
}
