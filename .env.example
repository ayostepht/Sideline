# Sideline configuration. Copy to .env and fill in what you need.
# Every variable is validated at startup. Leave a value empty to use its default.

# Your Sleeper username. Optional; the onboarding screen can set it instead.
SLEEPER_USERNAME=

# Sleeper league id to open by default. Optional.
DEFAULT_LEAGUE_ID=

# Where SQLite, caches, and backups live. Default: /data (use ./data for local dev).
DATA_DIR=/data

# Display timezone. Default: America/New_York.
TZ=America/New_York

# Set to turn on password login. Leave empty for no password.
APP_PASSWORD=

# Required when APP_PASSWORD is set. At least 32 characters. Example: openssl rand -hex 32
SESSION_SECRET=

# User and group id that own files in DATA_DIR. Default 1000/1000 (Unraid usually uses 99/100).
PUID=1000
PGID=1000

# Pull supplementary nflverse data. Default: true.
ENABLE_NFLVERSE=true

# Optional API key for betting odds. Leave empty to disable.
ODDS_API_KEY=

# Sync schedule overrides, one per job, as cron expressions.
# Leave empty to use the built-in defaults (PLAN.md section 3.1).
SYNC_STATE_CRON=
SYNC_LEAGUE_CRON=
SYNC_USERS_CRON=
SYNC_ROSTERS_CRON=
SYNC_MATCHUPS_CRON=
SYNC_TRANSACTIONS_CRON=
SYNC_PLAYERS_CRON=
SYNC_TRENDING_CRON=
SYNC_STATS_CRON=
SYNC_PROJECTIONS_CRON=
SYNC_NFLVERSE_CRON=

# Log verbosity: fatal, error, warn, info, debug, trace. Default: info.
LOG_LEVEL=info

# Port the web server listens on. Default: 3000.
PORT=3000

# Set to 1 to enable the /dev/gallery component page in a production build.
# Screenshots and the gate set it on a fixture-seeded database. Leave unset for real use.
SIDELINE_GALLERY=

# Extra hosts allowed to load Next dev assets, comma-separated. Set by "pnpm dev:lan"; dev only.
SIDELINE_DEV_ORIGINS=
